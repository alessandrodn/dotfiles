{
    "editor.fontFamily": "MonoLisa Light, Menlo, Monaco",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.wordWrap": "on",
    "editor.inlineSuggest.enabled": true,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.minimap.enabled": false,
    "editor.tokenColorCustomizations": {
        "[Alabaster Dark]": {
            "textMateRules": [
                {
                    "scope": [
                        "comment",
                        "punctuation.definition.comment"
                    ],
                    "settings": {
                        "foreground": "#f26d8a",
                    }
                }
            ]
        }
    },
    "debug.console.fontSize": 13,
    "terminal.integrated.fontFamily": "Monolisa Light, Menlo, Monaco",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.cursorBlinking": true,
    "workbench.colorTheme": "Alabaster Dark",
    "workbench.colorCustomizations": {
        "[Dracula Theme]": {
            "terminal.background": "#0b0d0f",
            "terminal.foreground": "#f8f8f2",
            "terminal.ansiBlack": "#000000",
            "terminal.ansiRed": "#ef766d",
            "terminal.ansiGreen": "#78cf77",
            "terminal.ansiYellow": "#feff7d",
            "terminal.ansiBlue": "#c4a9f4",
            "terminal.ansiMagenta": "#f297cd",
            "terminal.ansiCyan": "#aceafb",
            "terminal.ansiWhite": "#f8f8f2",
            "terminal.ansiBrightBlack": "#5a5a5a",
            "terminal.ansiBrightRed": "#ff938e",
            "terminal.ansiBrightGreen": "#98f099",
            "terminal.ansiBrightYellow": "#fbfb90",
            "terminal.ansiBrightBlue": "#d8c4ff",
            "terminal.ansiBrightMagenta": "#ffb1E2",
            "terminal.ansiBrightCyan": "#c8f8ff",
            "terminal.ansiBrightWhite": "#ffffff",
            "input.background": "#0b0d0f",
            "sideBarSectionHeader.background": "#0b0d0f",
            "tab.activeBackground": "#0b0d0f",
            "editor.background": "#0b0d0f",
            "editor.snippetTabstopHighlightBackground": "#0b0d0f",
            "editor.snippetFinalTabstopHighlightBackground": "#0b0d0f",
            "editorHoverWidget.background": "#0b0d0f",
            "peekViewEditor.background": "#0b0d0f",
            "panel.background": "#0b0d0f",
            "breadcrumb.background": "#0b0d0f"
        },
    },
    "workbench.startupEditor": "none",
    "workbench.editor.wrapTabs": true,
    "workbench.activityBar.location": "top",
    "workbench.settings.applyToAllProfiles": [
        "editor.fontSize",
        "editor.fontFamily",
        "editor.fontLigatures",
        "editor.insertSpaces",
        "editor.minimap.enabled",
        "editor.tokenColorCustomizations",
        "editor.wordWrap",
        "debug.console.fontSize",
        "terminal.integrated.fontFamily",
        "terminal.integrated.fontSize",
        "terminal.integrated.fontLigatures",
        "terminal.integrated.cursorStyle",
        "terminal.integrated.cursorBlinking",
        "workbench.colorTheme",
        "workbench.colorCustomizations",
        "workbench.activityBar.location",
    ],
    "window.customTitleBarVisibility": "auto",
    "security.workspace.trust.untrustedFiles": "open",
    "github.copilot.nextEditSuggestions.enabled": true,
}
